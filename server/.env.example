PORT=5000
NODE_ENV=development

# Database Configuration (auto, mysql, or sqlite)
# 'auto' automatically uses MySQL if accessible, otherwise seamlessly defaults to native SQLite
DB_ENGINE=auto
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=devflow_db
DB_PORT=3306
SQLITE_PATH=./database/devflow.sqlite

# Authentication
JWT_SECRET=your_jwt_secret_change_in_production_key_2026
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# GitHub Integration (Optional)
GITHUB_TOKEN=your_github_personal_access_token_optional
GITHUB_OWNER=ranadeepyasa
GITHUB_REPO=Student-Management-System

# Demo Seed Credentials
DEMO_USER_PASSWORD=Admin@Woxsen2026!
